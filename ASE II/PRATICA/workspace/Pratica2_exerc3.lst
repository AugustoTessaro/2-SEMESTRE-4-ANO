Fluxo de Potencia Otimo (AC-OPF) - Minimizacao de Custos
C o m p i l a t i o n


   2   
   3  Set
   4     i        'barras'            / 1*4   /
   5     slack(i) barra de referencia / 1     /
   6     GB(i)    'barras de geracao' / 1,2,3 /;
   7   
   8  Scalar
   9     Sbase / 100 /;
  10   
  11  Alias (i,j);
  12   
  13  Table GenD(i,*) 'Caracteristicas das unidades geradoras (Exercicio 1)'
  14         pmax  pmin    a      b    c     Qmax  Qmin
  15     1   450   200     0.004  5.2  500   9999  -9999
  16     2   350   150     0.006  5.0  400   9999  -9999
  17     3   235   100     0.008  5.0  200   9999  -9999;
  18   
  19  Table BD(i,*) 'Demanda de cada barra em MW e MVAr (Exercicio 2)'
  20         Pd   Qd
  21     1   0    0
  22     2   0    0
  23     3   220  136.34
  24     4   280  173.52;
  25   
  26  Table LN(i,j,*) 'Caracteristicas das linhas de transmissao'
  27            r         x        b       limit
  28     1 .4   0.00744   0.0372   0.0775  9999
  29     1 .3   0.01008   0.0504   0.1025  9999
  30     2 .3   0.00744   0.0372   0.0775  9999
  31     2 .4   0.01272   0.0636   0.1275  9999;
  32   
  33  * --- PRE-PROCESSAMENTO DOS PARAMETROS DA REDE ---
  34  LN(i,j,'x')$(LN(i,j,'x')=0) = LN(j,i,'x');
  35  LN(i,j,'r')$(LN(i,j,'r')=0) = LN(j,i,'r');
  36  LN(i,j,'b')$(LN(i,j,'b')=0) = LN(j,i,'b');
  37  LN(i,j,'Limit')$(LN(i,j,'Limit')=0) = LN(j,i,'Limit');
  38   
  39  LN(i,j,'z')$LN(i,j,'Limit') = sqrt(sqr(LN(i,j,'x')) + sqr(LN(i,j,'r')));
  40  LN(j,i,'z')$(LN(i,j,'z')=0) = LN(i,j,'z');
  41   
  42  LN(i,j,'th')$(LN(i,j,'Limit') and LN(i,j,'x') and LN(i,j,'r'))   = arctan(LN(i,j,'x')/LN(i,j,'r'));
  43  LN(i,j,'th')$(LN(i,j,'Limit') and LN(i,j,'x') and LN(i,j,'r')=0) = pi/2;
  44  LN(i,j,'th')$(LN(i,j,'Limit') and LN(i,j,'r') and LN(i,j,'x')=0) = 0;
  45  LN(j,i,'th')$LN(i,j,'Limit') = LN(i,j,'th');
  46   
  47  Parameter cx(i,j);
  48  cx(i,j)$(LN(i,j,'limit') and LN(j,i,'limit')) = 1;
  49  cx(i,j)$(cx(j,i)) = 1;
  50   
  51  * --- VARIAVEIS E EQUACOES ---
  52  Variable CT, Pij(i,j), Qij(i,j), Pg(i), Qg(i), Va(i), V(i);
  53  Equation eq1, eq2, eq_P, eq_Q, eq_cost, eq6;
  54   
  55  * Fluxo de Potencia Ativa nas linhas
  56  eq1(i,j)$cx(i,j)..
  57     Pij(i,j) =e= (sqr(V(i))*cos(LN(j,i,'th')) - V(i)*V(j)*cos(Va(i) - Va(j) + LN(j,i,'th'))) / LN(j,i,'z');
  58   
  59  * Fluxo de Potencia Reativa nas linhas
  60  eq2(i,j)$cx(i,j)..
  61     Qij(i,j) =e= (sqr(V(i))*sin(LN(j,i,'th')) - V(i)*V(j)*sin(Va(i) - Va(j) + LN(j,i,'th'))) / LN(j,i,'z') - LN(j,i,'b')*sqr(V(i))/2;
  62   
  63  * Balanco Nodal de Potencia Ativa (Geracao - Carga = Fluxo injetado)
  64  eq_P(i)..
  65      Pg(i)$GB(i) - BD(i,'Pd')/Sbase =e= sum(j$cx(j,i), Pij(i,j));
  66   
  67  * Balanco Nodal de Potencia Reativa
  68  eq_Q(i)..
  69      Qg(i)$GB(i) - BD(i,'Qd')/Sbase =e= sum(j$cx(j,i), Qij(i,j));
  70   
  71  * Funcao Custo (Convertendo Pg de p.u. para MW para o calculo financeiro)
  72  eq_cost..
  73     CT =e= sum(i$GB(i), GenD(i,'c') + GenD(i,'b')*(Pg(i)*Sbase) + GenD(i,'a')*sqr(Pg(i)*Sbase));
  74   
  75  * Limite termico das linhas
  76  eq6(i,j)$cx(i,j).. sqr(Pij(i,j)) + sqr(Qij(i,j)) =l= sqr(LN(i,j,'Limit')/Sbase);
  77   
  78  Model loadflow /all/;
  79   
  80  * --- LIMITES DAS VARIAVEIS ---
  81  Pg.lo(i)$GB(i) = GenD(i,'Pmin')/Sbase;
  82  Pg.up(i)$GB(i) = GenD(i,'Pmax')/Sbase;
  83  Qg.lo(i)$GB(i) = GenD(i,'Qmin')/Sbase;
  84  Qg.up(i)$GB(i) = GenD(i,'Qmax')/Sbase;
  85   
  86  Va.up(i)     = pi/2;
  87  Va.lo(i)     =-pi/2;
  88  Va.l(i)      = 0;
  89  Va.fx(slack) = 0;
  90   
  91  V.lo(i)  = 0.90;
  92  V.up(i)  = 1.10;
  93  V.l(i)   = 1;
  94   
  95  * Fixando a tensao da barra slack para o referencial de fase
  96  V.fx('1') = 1.0;
  97   
  98  * Obs: Deixei as tensoes V2 e V3 livres entre 0.9 e 1.1 para que o
  99  * solver otimize tambem a injecao de reativos minimizando perdas.
 100   
 101  * --- SOLUCAO ---
 102  solve loadflow minimizing CT using nlp;
 103   
 104  * --- RELATORIO DE EXPORTACAO ---
 105  Parameter report(i,*), PerdasTotais;
 106  report(i,'V (pu)')    = V.l(i);
 107  report(i,'Ang (grau)')= Va.l(i) * 180 / pi;
 108  report(i,'Pg (MW)')   = Pg.l(i) * Sbase;
 109  report(i,'Qg (MVAr)') = Qg.l(i) * Sbase;
 110   
 111  PerdasTotais = sum(i, Pg.l(i)*Sbase) - sum(i, BD(i,'Pd'));
 112   
 113  display CT.l, PerdasTotais;
 114  display report;
 115  Parameter IC(i) 'Custo Incremental da maquina ($/MWh)';
 116  Parameter LMP(i) 'Preco Marginal Nodal / Lambda Local ($/MWh)';
 117   
 118  * Derivada da funcao custo: dF/dP = 2*a*P + b
 119  IC(i)$GB(i) = 2 * GenD(i,'a') * (Pg.l(i)*Sbase) + GenD(i,'b');
 120   
 121  * Extraindo o multiplicador de Lagrange (shadow price) da equacao de balanco de potencia
 122  * Divide-se por Sbase porque a equacao foi montada em p.u.
 123  LMP(i)$GB(i) = eq_P.m(i) / Sbase;
 124  Parameter FatorPenalizacao(i) 'Fator de Penalizacao equivalente (referencia na Barra Slack)';
 125   
 126  * Fator de Penalizacao = LMP da barra / LMP da barra de referencia (Slack)
 127  FatorPenalizacao(i)$GB(i) = LMP(i) / LMP('1');
 128   
 129  display FatorPenalizacao;
 130  display IC, LMP;
 131   


